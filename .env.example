# ============================================================
# BYBIT CRYPTO BREAKOUT BOT – environment configuration template
# Copy this file to .env and fill in your real credentials.
# NEVER commit the .env file.
# ============================================================

# ---------- MODE ----------
MODE=demo                    # paper | demo | live
SYMBOL=BTCUSDT               # default active symbol (scanner overrides this)
BASE_CURRENCY=USDT
CAPITAL=1000                 # used for sizing in paper mode; live/demo reads real balance

# ---------- BYBIT V5 ----------
# Create demo-account API keys at: https://www.bybit.com/ (Demo Trading -> API)
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_DEMO=true              # true = api-demo.bybit.com (demo trading)
BYBIT_TESTNET=false          # true = public testnet (overrides demo)
BYBIT_LEVERAGE=5             # leverage applied per symbol

# ---------- RISK (must match config/config.yaml risk: section) ----------
RISK_PER_TRADE=1.0
MAX_DAILY_LOSS=5.0
MAX_WEEKLY_LOSS=12.0
MAX_TRADES_PER_DAY=40
MIN_CONFIDENCE=70

# ---------- ALERTS ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---------- REDIS (optional) ----------
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS=false

# ---------- DATABASE ----------
DATABASE_URL=sqlite:///./database/crypto_bot.db

# ---------- LOGGING ----------
LOG_LEVEL=INFO
LOG_DIR=logs
